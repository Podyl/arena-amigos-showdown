+
+/* Arena Amigos polish */
+html, body, #root { height: 100%; overscroll-behavior: none; }
+body { margin: 0; overflow: hidden; font-family: Inter, ui-rounded, "Arial Rounded MT Bold", system-ui, sans-serif; }
+button { -webkit-tap-highlight-color: transparent; }
+.arena-menu {
+  background:
+    radial-gradient(circle at 50% 25%, rgb(112 80 255 / .36), transparent 28%),
+    radial-gradient(circle at 15% 75%, rgb(39 184 255 / .25), transparent 30%),
+    linear-gradient(160deg, #1b1640 0%, #24175a 42%, #101b4a 100%);
+}
+.arena-menu::before {
+  content: "";
+  position: absolute; inset: 0; pointer-events: none; opacity: .16;
+  background-image: radial-gradient(circle, #fff 1.5px, transparent 1.5px);
+  background-size: 28px 28px;
+  mask-image: linear-gradient(to bottom, #000, transparent 75%);
+}
+.arena-logo {
+  text-shadow: 0 5px 0 #5329a8, 0 9px 0 #241155, 0 14px 32px rgb(0 0 0 / .48);
+  transform: rotate(-1deg);
+}
+.arena-play {
+  background: linear-gradient(#ffcf33, #ff9d18);
+  border: 3px solid #fff3a8;
+  box-shadow: 0 7px 0 #b6550a, 0 12px 28px rgb(0 0 0 / .36);
+  text-shadow: 0 2px 0 rgb(120 55 0 / .55);
+}
+.arena-play:active { box-shadow: 0 3px 0 #b6550a, 0 7px 18px rgb(0 0 0 / .3); }
+
+/* Mobile-game presentation pass */
+.arena-select {
+  background:
+    radial-gradient(circle at 50% 8%, rgb(86 100 255 / .34), transparent 30%),
+    linear-gradient(180deg, #131737 0%, #10142d 55%, #0d1024 100%);
+}
+.arena-picked {
+  background:
+    radial-gradient(circle at 28% 34%, rgb(255 211 74 / .18), transparent 32%),
+    linear-gradient(135deg, rgb(77 88 198 / .72), rgb(33 37 96 / .88));
+  box-shadow: inset 0 1px 0 rgb(255 255 255 / .12), 0 18px 44px rgb(0 0 0 / .28);
+}
+.brawler-card {
+  background: linear-gradient(160deg, rgb(255 255 255 / .09), rgb(255 255 255 / .035));
+  box-shadow: inset 0 1px 0 rgb(255 255 255 / .08), 0 8px 24px rgb(0 0 0 / .18);
+}
+.brawler-card.is-picked {
+  background: linear-gradient(160deg, rgb(255 213 72 / .2), rgb(255 255 255 / .06));
+  transform: translateY(-2px);
+  box-shadow: inset 0 1px 0 rgb(255 255 255 / .18), 0 12px 28px rgb(0 0 0 / .28);
+}
+.arena-hero {
+  background:
+    radial-gradient(circle at 50% 34%, rgb(255 225 110 / .26), transparent 45%),
+    linear-gradient(145deg, rgb(98 76 230 / .55), rgb(32 31 91 / .65));
+  box-shadow: 0 16px 42px rgb(0 0 0 / .35), inset 0 1px 0 rgb(255 255 255 / .2);
+}
+@media (max-width: 420px) {
+  .arena-logo { font-size: 2.9rem; }
+}
